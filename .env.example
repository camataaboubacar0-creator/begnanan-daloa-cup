# Copiez ce fichier en .env.local pour travailler en local,
# et renseignez les mêmes variables dans Vercel (Settings > Environment Variables).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : uniquement côté serveur, ne jamais la partager ni la publier.
SUPABASE_SERVICE_ROLE_KEY=

# Facultatif : envoi automatique des annonces par WhatsApp (compte WhatsApp Business Platform de Meta).
# Sans ces valeurs, le comité partage les annonces à la main depuis l'espace admin.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
# WHATSAPP_TEMPLATE_LANG=fr
