# Copiez ce fichier en .env.local pour travailler en local,
# et renseignez les mêmes variables dans Vercel (Settings > Environment Variables).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : uniquement côté serveur, ne jamais la partager ni la publier.
SUPABASE_SERVICE_ROLE_KEY=
